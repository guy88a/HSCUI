<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!--
    HearthstoneCombatUI - Config Window (1.12-compatible)
    Fixed: Correct TGA handling and restored proper border backdrop.
    -->

    <!-- 1 - Main Dialog -->
    <Frame name="HSCUI_ConfigFrame" hidden="true" movable="true" enableMouse="true" toplevel="true"
        frameStrata="DIALOG" frameLevel="10">
        <Size x="260" y="360" />
        <Anchors>
            <Anchor point="CENTER" />
        </Anchors>

        <!-- Proper Backdrop (1.12-compatible) -->
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBackground"
                    file="Interface\AddOns\HearthstoneCombatUI\Media\General\Config\dialog_wooden_bg_1.tga"
                    tile="true">
                    <Anchors>
                        <Anchor point="TOPLEFT" />
                        <Anchor point="BOTTOMRIGHT" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <Backdrop edgeFile="Interface\AddOns\HearthstoneCombatUI\Media\General\Config\dialog_border_2b_8slice.tga">
            <EdgeSize>
                <AbsValue val="16" />
            </EdgeSize>
            <BackgroundInsets>
                <AbsInset left="5" right="5" top="5" bottom="5" />
            </BackgroundInsets>
        </Backdrop>

        <Frames>
            <!-- 1.1 - Main Title -->
            <Frame name="$parentMainTitle">
                <Size x="260" y="45" />
                <Anchors>
                    <Anchor point="TOP" x="0" y="-10" />
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="$parentTitleBG"
                            file="Interface\AddOns\HearthstoneCombatUI\Media\General\Config\dialog_title_strip.tga"
                            alphaMode="BLEND">
                            <Size x="250" y="64" />
                            <!-- <Anchors>
                                <Anchor point="CENTER" />
                            </Anchors> -->
                            <Anchors>
                                <Anchor point="CENTER" relativeTo="$parent" relativePoint="BOTTOM">
                                    <Offset>
                                        <AbsDimension x="0" y="-6"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                            <TexCoords left="0" right="1" top="0.365" bottom="0.635" />
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <FontString name="$parentText" inherits="GameFontHighlightLarge" text="">
                            <Color r="1.0" g="1.0" b="1.0" />
                            <Anchors>
                                <Anchor point="CENTER" relativeTo="$parent" relativePoint="BOTTOM">
                                    <Offset>
                                        <AbsDimension x="0" y="5"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <!-- 1.2 - Board Section -->
            <Frame name="$parentBoardSection">
                <Size x="210" y="360" />
                <!-- <Anchors>
                    <Anchor point="TOP" relativeTo="$parentMainTitle" relativePoint="BOTTOM" x="0" y="-10" />
                </Anchors> -->
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parentMainTitle" relativePoint="BOTTOM">
                        <Offset>
                            <AbsDimension x="0" y="-10"/>
                        </Offset>
                    </Anchor>
                </Anchors>

                <Frames>
                    <!-- 1.21 - Board Title -->
                    <Frame name="$parentBoardTitle">
                        <Size x="210" y="30" />
                        <Anchors>
                            <Anchor point="TOP" relativeTo="$parent" relativePoint="TOP">
                                <Offset>
                                    <AbsDimension x="-8" y="-10"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        
                        <Layers>
                            <!-- Background image, purely visual -->
                            <Layer level="BACKGROUND">
                                <Texture name="$parentTitleBG"
                                    file="Interface\AddOns\HearthstoneCombatUI\Media\General\Config\section_title_1.tga"
                                    alphaMode="BLEND">
                                    <Size x="100" y="30" />
                                    <Anchors>
                                        <Anchor point="CENTER" x="0" y="0" />
                                        <Anchor point="CENTER" x="0" y="0" />
                                    </Anchors>
                                </Texture>
                            </Layer>

                            <!-- Text layer -->
                            <Layer level="ARTWORK">
                                <FontString name="$parentText" inherits="GameFontHighlight" text="Board">
                                    <Color r="1.0" g="0.82" b="0.0" />
                                    <JustifyH value="CENTER" />
                                    <Size x="100" y="30" />
                                    <Anchors>
                                        <Anchor point="CENTER" x="0" y="-10" />
                                    </Anchors>
                                </FontString>
                            </Layer>
                        </Layers>
                    </Frame>

                    <!-- 1.22 - Properties Frame -->
                    <Frame name="$parentPropertiesFrame">
                        <Size x="240" y="220" />
                        <Anchors>
                            <Anchor point="TOP" relativeTo="$parent" relativePoint="TOP">
                                <Offset>
                                    <AbsDimension x="0" y="-25"/>
                                </Offset>
                            </Anchor>
                        </Anchors>

                        <Layers>
                            <Layer level="BORDER">
                                <Texture name="$parentBackground"
                                    file="Interface\AddOns\HearthstoneCombatUI\Media\General\Config\dialog_page_bg_1.tga"
                                    tile="true">
                                    <Anchors>
                                        <Anchor point="TOPLEFT" />
                                        <Anchor point="BOTTOMRIGHT" />
                                    </Anchors>
                                </Texture>
                            </Layer>
                        </Layers>

                        <Frames>
                            <!-- 1.22.0 - Scale Field -->
                            <Frame name="$parentScaleField">
                                <Size x="180" y="50" />
                                <!-- <Anchors>
                                    <Anchor point="TOP" relativeTo="$parent" relativePoint="TOP" x="0" y="-20" />
                                </Anchors> -->
                                <Anchors>
                                    <Anchor point="TOP" relativeTo="$parent" relativePoint="TOP">
                                        <Offset>
                                            <AbsDimension x="0" y="-20"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>

                                <Layers>
                                    <Layer level="ARTWORK">
                                        <FontString name="$parentLabel" inherits="GameFontNormalSmall" text="Scale">
                                            <Color r="1.0" g="0.82" b="0.0" />
                                            <Anchors>
                                                <Anchor point="LEFT" x="8" y="0" />
                                            </Anchors>
                                        </FontString>
                                    </Layer>
                                </Layers>
                                <Frames>
                                    <EditBox name="$parentValueBox" autoFocus="false" inherits="InputBoxTemplate">
                                        <Size x="35" y="16" />
                                        <Anchors>
                                            <Anchor point="RIGHT" x="-10" y="0" />
                                        </Anchors>
                                    </EditBox>
                                    <Slider name="$parentSlider" inherits="OptionsSliderTemplate" minValue="0.5" maxValue="2.0" defaultValue="1.0" valueStep="0.1">
                                        <Size x="180" y="17" />
                                        <Anchors>
                                            <Anchor point="BOTTOM" x="0" y="6" />
                                        </Anchors>
                                        <Low> </Low>
                                        <High> </High>
                                    </Slider>
                                </Frames>
                            </Frame>

                            <!-- 1.22.1 - Position X Field -->
                            <Frame name="$parentPositionXField">
                                <Size x="180" y="50" />
                                <Anchors>
                                    <Anchor point="TOP" relativeTo="$parentScaleField" relativePoint="BOTTOM" x="0" y="-20" />
                                </Anchors>
                                <Layers>
                                    <Layer level="ARTWORK">
                                        <FontString name="$parentLabel" inherits="GameFontNormalSmall" text="Position X">
                                            <Color r="1.0" g="0.82" b="0.0" />
                                            <Anchors>
                                                <Anchor point="LEFT" x="8" y="0" />
                                            </Anchors>
                                        </FontString>
                                    </Layer>
                                </Layers>
                                <Frames>
                                    <EditBox name="$parentValueBox" autoFocus="false" inherits="InputBoxTemplate">
                                        <Size x="35" y="16" />
                                        <Anchors>
                                            <Anchor point="RIGHT" x="-10" y="0" />
                                        </Anchors>
                                    </EditBox>
                                    <Slider name="$parentSlider" inherits="OptionsSliderTemplate" minValue="-100" maxValue="100" defaultValue="0" valueStep="1">
                                        <Size x="180" y="17" />
                                        <Anchors>
                                            <Anchor point="BOTTOM" x="0" y="6" />
                                        </Anchors>
                                        <Low> </Low>
                                        <High> </High>
                                    </Slider>
                                </Frames>
                            </Frame>

                            <!-- 1.22.2 - Position Y Field -->
                            <Frame name="$parentPositionYField">
                                <Size x="180" y="50" />
                                <Anchors>
                                    <Anchor point="TOP" relativeTo="$parentPositionXField" relativePoint="BOTTOM" x="0" y="-20" />
                                </Anchors>
                                <Layers>
                                    <Layer level="ARTWORK">
                                        <FontString name="$parentLabel" inherits="GameFontNormalSmall" text="Position Y">
                                            <Color r="1.0" g="0.82" b="0.0" />
                                            <Anchors>
                                                <Anchor point="LEFT" x="8" y="0" />
                                            </Anchors>
                                        </FontString>
                                    </Layer>
                                </Layers>
                                <Frames>
                                    <EditBox name="$parentValueBox" autoFocus="false" inherits="InputBoxTemplate">
                                        <Size x="35" y="16" />
                                        <Anchors>
                                            <Anchor point="RIGHT" x="-10" y="0" />
                                        </Anchors>
                                    </EditBox>
                                    <Slider name="$parentSlider" inherits="OptionsSliderTemplate" minValue="-100" maxValue="100" defaultValue="0" valueStep="1">
                                        <Size x="180" y="17" />
                                        <Anchors>
                                            <Anchor point="BOTTOM" x="0" y="6" />
                                        </Anchors>
                                        <Low> </Low>
                                        <High> </High>
                                    </Slider>
                                </Frames>
                            </Frame>
                        </Frames>
                    </Frame>
                </Frames>
            </Frame>

            <!-- Bottom Navbar -->
            <Frame name="$parentBottomNav">
                <Size x="240" y="30" />
                <Anchors>
                    <Anchor point="BOTTOM" relativeTo="$parent" relativePoint="BOTTOM">
                        <Offset>
                            <AbsDimension x="0" y="9"/>
                        </Offset>
                    </Anchor>
                </Anchors>

                <Frames>
                    <Button name="$parentButton1" inherits="UIPanelButtonTemplate">
                        <Size x="40" y="40" />
                        <Anchors>
                            <Anchor point="LEFT" relativeTo="$parent" relativePoint="LEFT">
                                <Offset>
                                    <AbsDimension x="28" y="12"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        <NormalTexture file="Interface\AddOns\HearthstoneCombatUI\Media\General\Config\navbar_button_dice_board.tga">
                            <!-- <TexCoords left="0" right="1" top="0.2465" bottom="0.7535" /> -->
                        </NormalTexture>
                        <PushedTexture file="Interface\AddOns\HearthstoneCombatUI\Media\General\Config\navbar_button_dice_board_pushed.tga">
                            <!-- <TexCoords left="0" right="1" top="0.2465" bottom="0.7535" /> -->
                        </PushedTexture>
                    </Button>

                    <Button name="$parentButton2" inherits="UIPanelButtonTemplate">
                        <Size x="40" y="40" />
                        <Anchors>
                            <Anchor point="RIGHT" relativeTo="$parent" relativePoint="CENTER">
                                <Offset>
                                    <AbsDimension x="-5" y="12"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        <NormalTexture file="Interface\AddOns\HearthstoneCombatUI\Media\General\Config\navbar_button_dice_trait.tga">
                            <!-- <TexCoords left="0" right="1" top="0.2465" bottom="0.7535" /> -->
                        </NormalTexture>
                        <PushedTexture file="Interface\AddOns\HearthstoneCombatUI\Media\General\Config\navbar_button_dice_trait_pushed.tga">
                            <!-- <TexCoords left="0" right="1" top="0.2465" bottom="0.7535" /> -->
                        </PushedTexture>
                    </Button>

                    <Button name="$parentButton3" inherits="UIPanelButtonTemplate">
                        <Size x="40" y="40" />
                        <Anchors>
                            <Anchor point="LEFT" relativeTo="$parent" relativePoint="CENTER">
                                <Offset>
                                    <AbsDimension x="5" y="12"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        <NormalTexture file="Interface\AddOns\HearthstoneCombatUI\Media\General\Config\navbar_button_dice_resources.tga">
                            <!-- <TexCoords left="0" right="1" top="0.2465" bottom="0.7535" /> -->
                        </NormalTexture>
                        <PushedTexture file="Interface\AddOns\HearthstoneCombatUI\Media\General\Config\navbar_button_dice_resources_pushed.tga">
                            <!-- <TexCoords left="0" right="1" top="0.2465" bottom="0.7535" /> -->
                        </PushedTexture>
                    </Button>

                    <Button name="$parentButton4" inherits="UIPanelButtonTemplate">
                        <Size x="40" y="40" />
                        <Anchors>
                            <Anchor point="RIGHT" relativeTo="$parent" relativePoint="RIGHT">
                                <Offset>
                                    <AbsDimension x="-28" y="12"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        <NormalTexture file="Interface\AddOns\HearthstoneCombatUI\Media\General\Config\navbar_button_dice_cards.tga">
                            <!-- <TexCoords left="0" right="1" top="0.2465" bottom="0.7535" /> -->
                        </NormalTexture>
                        <PushedTexture file="Interface\AddOns\HearthstoneCombatUI\Media\General\Config\navbar_button_dice_cards_pushed.tga">
                            <!-- <TexCoords left="0" right="1" top="0.2465" bottom="0.7535" /> -->
                        </PushedTexture>
                    </Button>
                </Frames>
            </Frame>
        </Frames>
    </Frame>
</Ui>
