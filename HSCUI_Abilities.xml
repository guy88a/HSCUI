<Ui xmlns="http://www.blizzard.com/wow/ui/"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

  <!-- ===================================== -->
  <!-- Abilities Component                     -->
  <!-- ===================================== -->
  <Frame name="HSCUI_AbilitiesFrame" parent="HSCUI_MainFrame" hidden="false" frameStrata="HIGH"
    frameLevel="1">
    <Size>
      <AbsDimension x="512" y="256" />
    </Size>

    <!-- Position: relative to parent (below resource bar) -->
    <Anchors>
      <Anchor point="CENTER">
        <Offset>
          <AbsDimension x="0" y="-130" />
        </Offset>
      </Anchor>
    </Anchors>

    <!-- ===================================== -->
    <!-- Layers: 3 ability cards (128x128)      -->
    <!-- ===================================== -->
    <Layers>
      <!-- Left Card -->
      <Layer level="BACKGROUND">
        <Texture name="HSCUI_AbilityCardLeft">
          <Size>
            <AbsDimension x="180" y="180" />
          </Size>
          <Anchors>
            <Anchor point="CENTER" relativeTo="$parent">
              <Offset>
                <AbsDimension x="-70" y="0" />
              </Offset>
            </Anchor>
          </Anchors>
        </Texture>
      </Layer>

      <!-- Center Card -->
      <Layer level="ARTWORK">
        <Texture name="HSCUI_AbilityCardCenter"
        >
          <Size>
            <AbsDimension x="180" y="180" />
          </Size>
          <Anchors>
            <Anchor point="CENTER" relativeTo="$parent">
              <Offset>
                <AbsDimension x="0" y="8" />
              </Offset>
            </Anchor>
          </Anchors>
        </Texture>
      </Layer>

      <!-- Right Card -->
      <Layer level="OVERLAY">
        <Texture name="HSCUI_AbilityCardRight"
        >
          <Size>
            <AbsDimension x="180" y="180" />
          </Size>
          <Anchors>
            <Anchor point="CENTER" relativeTo="$parent">
              <Offset>
                <AbsDimension x="70" y="0" />
              </Offset>
            </Anchor>
          </Anchors>
        </Texture>
      </Layer>
    </Layers>

    <!-- ===================================== -->
    <!-- Initialization Script                  -->
    <!-- ===================================== -->
    <Scripts>
      <OnLoad>
        DEFAULT_CHAT_FRAME:AddMessage("HSCUI_AbilitiesFrame visible!");
        HSCUI_SetAbilityTextures();
        this:Show();
      </OnLoad>
    </Scripts>
  </Frame>

</Ui>