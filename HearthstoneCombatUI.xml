<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

  <!-- ===================================== -->
  <!-- Hearthstone Combat UI - Main File     -->
  <!-- ===================================== -->
  <!--
    Root XML for the Hearthstone Combat UI addon.
    Defines the main container frame and then includes all component XMLs.

    Components:
      - Trait Component (weapon swing + combo tracking)
      - Resource Component (energy/rage/mana + combo bar)
      - Abilities Component (3 Hearthstone-style cards)

    NOTE: The main frame is declared BEFORE includes so child frames
          can safely use parent="HSCUI_MainFrame" and anchor to it.
  -->

  <!-- ===================================== -->
  <!-- Root Container                        -->
  <!-- ===================================== -->
  <!--
    HSCUI_MainFrame serves as the parent frame for all components.
    It doesn't draw art by itself; it only provides a common anchor/scale.
  -->
  <Frame name="HSCUI_MainFrame" hidden="true" frameStrata="HIGH">
    <Size>
      <AbsDimension x="512" y="512"/>
    </Size>

    <!-- Position: Centered on screen (adjust offsets to move the whole UI) -->
    <Anchors>
      <Anchor point="CENTER">
        <Offset><AbsDimension x="0" y="-60"/></Offset>
      </Anchor>
    </Anchors>
  </Frame>

  <!-- ===================================== -->
  <!-- Includes (children expect the parent) -->
  <!-- ===================================== -->
  <!-- Each component file defines its own frame & layout, parented to Main. -->
  <Include file="HSCUI_Trait.xml"/>
  <Include file="HSCUI_Abilities.xml"/>
  <Include file="HSCUI_Resource.xml"/>

</Ui>