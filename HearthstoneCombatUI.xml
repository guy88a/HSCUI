<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- Main Parent Frame -->
    <Frame name="HSCUI_MainFrame" hidden="false" movable="true" enableMouse="true" clampedToScreen="true" frameStrata="HIGH">
        <Size>
            <AbsDimension x="512" y="256"/>
        </Size>
        <Anchors>
            <Anchor point="CENTER">
                <Offset>
                    <AbsDimension x="0" y="-100"/>
                </Offset>
            </Anchor>
        </Anchors>

        <!-- Temporary visual background and border -->
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <TileSize val="32"/>
            <EdgeSize val="16"/>
            <BackgroundInsets>
                <AbsInset left="5" right="5" top="5" bottom="5"/>
            </BackgroundInsets>
        </Backdrop>

        <!-- Load Trait Component -->
        <Include file="Components\Trait\Trait.xml"/>

        <!-- Load Resource Component -->
        <Include file="Components\Resources\Resources.xml"/>

        <!-- Load Abilities Component -->
        <Include file="Components\Abilities\Abilities.xml"/>

    </Frame>
</Ui>